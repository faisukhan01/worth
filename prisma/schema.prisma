generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Lodestar platform domain model (web tier).
// Live telemetry lives in the Go ingest-gateway; this store keeps the
// organisational entities: service catalog, alerting, incidents, team,
// API keys and metered usage for billing.
// ---------------------------------------------------------------------------

model Service {
  id        String   @id @default(cuid())
  key       String   @unique // matches gateway tags.service, e.g. "checkout-service"
  name      String
  tier      String   @default("standard") // edge | critical | standard
  owner     String
  language  String   @default("go")
  sloTarget Float    @default(99.9) // availability target %
  createdAt DateTime @default(now())

  @@index([tier])
}

model AlertRule {
  id             String   @id @default(cuid())
  serviceKey     String
  metric         String // e.g. error.rate, latency.p99
  comparator     String   @default("above") // above | below
  threshold      Float
  windowMinutes  Int      @default(5)
  severity       String   @default("warning") // critical | warning | info
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([serviceKey, enabled])
}

model Incident {
  id             String    @id @default(cuid())
  serviceKey     String
  title          String
  severity       String // critical | warning | info
  status         String    @default("triggered") // triggered | acknowledged | mitigated | resolved
  source         String    @default("aiops") // aiops | manual
  dedupKey       String? // stable promotion key, e.g. "checkout-service:latency.p99"
  startedAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  assignee       String?
  timeline       String    @default("[]") // JSON: [{ts, event, detail}]
  postmortem     String? // AI-drafted postmortem markdown

  @@index([status, startedAt])
  @@index([dedupKey])
}

model TeamMember {
  id     String @id @default(cuid())
  name   String
  email  String @unique
  role   String // owner | sre | engineer | observer
  hue    Int    @default(150) // avatar hue
  onCall Boolean @default(false)
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String @unique // display form, e.g. pg_live_a1b2
  env        String    @default("production")
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model UsageRecord {
  id         String @id @default(cuid())
  serviceKey String
  day        String // yyyy-mm-dd
  metricName String // ingested.events | ingested.gb | aiops.insights
  quantity   Float
  unit       String

  @@index([serviceKey, day])
  @@index([metricName, day])
}

// ---------------------------------------------------------------------------
// Admin / multi-tenant onboarding: client companies registered by the platform
// operator, their ingest API keys, monitored endpoints and integration
// credentials (webhooks, Slack, vendor keys).
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // url-safe id, e.g. acme-corp
  contact   String   @default("") // billing / ops contact email
  plan      String   @default("starter") // starter | growth | scale | enterprise
  status    String   @default("active") // active | suspended
  notes     String   @default("")
  createdAt DateTime @default(now())

  keys        TenantKey[]
  sites       MonitoredSite[]
  credentials TenantCredential[]

  @@index([status])
}

model TenantKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label      String    @default("ingest") // what the key is for, e.g. "website ingest"
  secret     String    @unique // full key, e.g. pg_live_xxxx… (activates via gateway API_KEYS)
  prefix     String // masked display form, e.g. pg_live_9f2a…c1
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([tenantId, revoked])
}

model MonitoredSite {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label         String    @default("") // e.g. "Marketing site"
  url           String
  kind          String    @default("website") // website | api | software
  lastStatus    String? // up | down
  lastHttpStatus Int?
  lastLatencyMs Int?
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId])
}

model TenantCredential {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String   @default("webhook") // webhook | slack | custom
  name      String // e.g. "Slack #alerts webhook"
  secret    String // full value; only masked form leaves the API
  createdAt DateTime @default(now())

  @@index([tenantId])
}
