# EditorConfig: https://editorconfig.org
# One config for the whole polyglot monorepo.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{go,java}]
indent_style = tab

[*.cs]
indent_size = 4

[Makefile]
indent_style = tab

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.tf]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2
