# Lodestar web console (control plane)
DATABASE_URL=file:/absolute/path/to/db/custom.db

# Data-plane endpoints (server-side routes -> upstream services)
LODESTAR_GATEWAY_URL=http://127.0.0.1:3100
LODESTAR_AIOPS_URL=http://127.0.0.1:3200
LODESTAR_API_KEY=pg_live_demo_key

# Ingest gateway
PORT=3100
API_KEYS=pg_live_demo_key

# AIOps engine
GATEWAY_URL=http://127.0.0.1:3100
GATEWAY_API_KEY=pg_live_demo_key

# Edge agent
PULSE_GATEWAY_URL=http://127.0.0.1:3100
PULSE_INTERVAL_MS=2000
PULSE_API_KEY=pg_live_demo_key
